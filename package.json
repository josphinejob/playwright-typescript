{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E framework demonstrating locator strategy, custom fixtures, and tagged test suites against SauceDemo.",
  "scripts": {
    "typecheck": "tsc",
    "test": "playwright test",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "PWHEADLESS=false playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.16.11",
    "typescript": "5.6.3"
  }
}
