# Copy to .env and adjust as needed. Every value below is optional,
# the defaults in test-data.ts and playwright.config.ts point at the
# public SauceDemo instance.

# Target base URL.
BASE_URL=https://www.saucedemo.com

# Username for the standard account used in normal flows.
E2E_USERNAME=standard_user

# Password applied to every demo account.
E2E_PASSWORD=secret_sauce

# Set to false to watch the browser while tests run.
PWHEADLESS=true
